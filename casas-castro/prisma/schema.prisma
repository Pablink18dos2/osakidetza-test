// Esquema de datos — Web de alquiler de casas en Castro Urdiales
//
// Base de datos: PostgreSQL (producción en Vercel + Neon/Supabase/Vercel Postgres).
//  - Los arrays (servicios, fotos) se guardan como Json (jsonb en Postgres).
//  - Los "enums" se modelan como String + unión de tipos en TypeScript
//    (src/types). Se pueden convertir a enum nativo de Postgres más adelante.
//
// url:       cadena de conexión "pooled" (PgBouncer) usada en runtime serverless.
// directUrl: conexión directa usada por Prisma Migrate. En local, ambas iguales.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Casa {
  id                  String    @id @default(uuid())
  nombre              String
  slug                String    @unique
  direccion           String
  lat                 Float?
  lng                 Float?
  descripcionCorta    String
  descripcionLarga    String
  capacidad           Int
  habitaciones        Int
  banos               Int
  servicios           Json      // string[]  ej. ["wifi","parking","jardín"]
  fotos               Json      // string[]  URLs de las imágenes
  precioTemporadaBaja Int       // €/noche
  precioTemporadaAlta Int?      // €/noche (opcional si no aplica)
  temporadaAltaInicio DateTime? // opcional
  temporadaAltaFin    DateTime? // opcional
  orden               Int       @default(0)
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt

  reservas Reserva[]
  resenas  Resena[]
}

model Reserva {
  id                String   @id @default(uuid())
  casa              Casa     @relation(fields: [casaId], references: [id], onDelete: Cascade)
  casaId            String
  nombreCliente     String
  emailCliente      String
  telefonoCliente   String
  numPersonas       Int
  fechaInicio       DateTime
  fechaFin          DateTime
  // estado: "provisional" | "confirmada" | "rechazada" | "expirada" | "bloqueo"
  //  - bloqueo = fechas bloqueadas manualmente por el propietario
  estado            String   @default("provisional")
  mensajeCliente    String?
  motivoRechazo     String?
  tokenConfirmacion String   @unique
  expiraEn          DateTime? // creadoEn + 48h, solo relevante si provisional
  creadoEn          DateTime  @default(now())
  actualizadoEn     DateTime  @updatedAt

  @@index([casaId, estado])
  @@index([estado, expiraEn])
}

model Resena {
  id           String   @id @default(uuid())
  casa         Casa?    @relation(fields: [casaId], references: [id], onDelete: Cascade)
  casaId       String?  // null = aplica a ambas casas
  nombreAutor  String
  texto        String
  valoracion   Int      // 1-5
  fecha        DateTime
  destacada    Boolean  @default(false)
  creadoEn     DateTime @default(now())

  @@index([casaId])
}
