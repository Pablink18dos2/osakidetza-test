# Copia este archivo a .env y rellena los valores.

# Base de datos.
#  - Desarrollo (SQLite):  DATABASE_URL="file:./dev.db"
#  - Producción (Postgres/Supabase): DATABASE_URL="postgresql://..."
DATABASE_URL="file:./dev.db"

# Envío de emails (Resend). Si RESEND_API_KEY está vacío, los emails
# se muestran por consola en vez de enviarse (útil en desarrollo).
RESEND_API_KEY=
EMAIL_FROM="Casas Castro <reservas@tudominio.com>"
EMAIL_PROPIETARIO=          # dirección donde llegan las solicitudes de reserva
ADMIN_EMAIL=               # email del propietario para el login del admin
ADMIN_PASSWORD_HASH=       # hash de la contraseña del admin (o usar Supabase Auth)

# URL pública del sitio (usada en los enlaces de los emails).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secreto para autenticar el cron que libera reservas provisionales caducadas.
CRON_SECRET=
