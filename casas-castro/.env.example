# Copia este archivo a .env y rellena los valores.

# Base de datos PostgreSQL.
#  - DATABASE_URL: cadena "pooled" (con PgBouncer) para el runtime serverless.
#  - DIRECT_URL:   conexión directa, usada por las migraciones de Prisma.
# En Neon/Supabase te dan ambas; en local pueden ser la misma.
DATABASE_URL="postgresql://usuario:password@host:5432/basedatos?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host:5432/basedatos?schema=public"

# Envío de emails (Resend). Si RESEND_API_KEY está vacío, los emails
# se muestran por consola en vez de enviarse (útil en desarrollo).
RESEND_API_KEY=
EMAIL_FROM="Casas Castro <reservas@tudominio.com>"
EMAIL_PROPIETARIO=          # dirección donde llegan las solicitudes de reserva

# Panel de administración.
ADMIN_EMAIL=               # email del propietario (informativo)
ADMIN_PASSWORD=            # contraseña del panel /admin
AUTH_SECRET=               # secreto largo y aleatorio para firmar la cookie de sesión

# URL pública del sitio (usada en los enlaces de los emails).
NEXT_PUBLIC_SITE_URL="https://tudominio.com"

# Secreto para autenticar el cron que libera reservas provisionales caducadas.
CRON_SECRET=
